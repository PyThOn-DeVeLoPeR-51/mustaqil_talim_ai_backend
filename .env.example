# Copy this file to .env and fill your local values.
# Example for local PostgreSQL on port 5433:
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5433/mustaqil_talim_db

# Change this in real use. Do not commit your real SECRET_KEY.
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database pool and logs
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
LOG_JSON=false

# AI Mentor LLM. "mock" xavfsiz default; Groq uchun "groq" qiling.
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_CHAT_HISTORY=12

# Tavsiya etilgan bepul boshlang‘ich provider: Groq.
# Faqat LLM_PROVIDER=groq bo‘lganda kerak.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GPT-OSS uchun: low, medium yoki high.
GROQ_REASONING_EFFORT=low

# AI Mentor feature routing
# 4 haftalik /plans/generate endpointi doim Groq ishlatadi va fallback qilmaydi.
AI_MENTOR_CHAT_PRIMARY_PROVIDER=groq
# gemini | openrouter | none
AI_MENTOR_CHAT_FALLBACK_PROVIDER=gemini
# Har student uchun UTC kunlik muvaffaqiyatli Groq chat javoblari limiti. <=0 = unlimited.
AI_MENTOR_GROQ_CHAT_DAILY_LIMIT=20

# Gemini fallback (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter fallback. Agar fallback=openrouter bo'lsa model nomini ham kiriting.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Mustaqil Talim AI Platforma

# Faqat LLM_PROVIDER=openai bo‘lganda kerak.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OpenAI-compatible proxy ishlatilmasa bo‘sh qoldiring.
OPENAI_BASE_URL=


# Persistent file storage
# local = app/uploads + app/rag_storage; r2 = Cloudflare R2 (production)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=app/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mustaqil-talim-ai
# Signed GET URL lifetime (15 minutes)
R2_PRESIGNED_GET_TTL_SECONDS=900

# RAG document ingestion
RAG_STORAGE_DIR=app/rag_storage
RAG_MAX_FILE_SIZE_MB=25
RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=250

# Teacher quotas and disk safety
RAG_TEACHER_STORAGE_LIMIT_MB=1024
RAG_TEACHER_DOCUMENT_LIMIT=100
RAG_STORAGE_MIN_FREE_MB=512

# Durable DB-backed processing queue
RAG_BACKGROUND_WORKER_ENABLED=true
RAG_WORKER_POLL_SECONDS=2
RAG_JOB_MAX_ATTEMPTS=3
RAG_JOB_RETRY_BASE_SECONDS=10
RAG_JOB_STALE_MINUTES=20

# RAG local multilingual embeddings (one-time Hugging Face download, then local)
# Local development fallback:
# RAG_EMBEDDING_PROVIDER=local_onnx_e5
# RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Production / low-RAM Render tavsiyasi:
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_ONNX_FILE=onnx/model.onnx
RAG_EMBEDDING_CACHE_DIR=app/rag_models
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_MAX_LENGTH=512
RAG_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_MAX_RETRIES=2
RAG_SEARCH_TOP_K=5
RAG_SEARCH_MAX_TOP_K=20

# AI Mentor chat + RAG
RAG_CHAT_ENABLED=true
RAG_CHAT_TOP_K=5
RAG_CHAT_MIN_SCORE=0.45
RAG_CHAT_MAX_CONTEXT_CHARS=9000
